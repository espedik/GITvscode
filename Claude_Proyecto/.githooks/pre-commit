#!/bin/sh
# Antes de cada commit, las marcas de hábitos del Chrome de esta PC van a
# Claude_Proyecto/Dashboard/habitos-sync.js, la auditoría de cada mes a auditoria-sync.js y los saldos de
# Finanzas —sin movimientos— a finanzas-sync.js, que el iPad
# y los demás dispositivos leen en la página publicada (Adán, 19-oct-2026: "cada día cuando haga algún
# commit, de cualquier cosa se actualicen los hábitos"; 1-nov-2026: "sube los datos de mis hábitos y
# auditoría"). Lo hace Dashboard/habitos-exportar.js. Nunca detiene un commit.
# Se activa una vez por clon: git config core.hooksPath Claude_Proyecto/.githooks
raiz="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
# Y el monitor de archivos que hace aparecer tus datos del navegador en `git status` (.githooks/fsmonitor-datos):
# si esta copia del repositorio no lo tiene, se activa aquí, sin que nadie corra nada.
[ -n "$(git config --get core.fsmonitor)" ] || git config core.fsmonitor "$raiz/Claude_Proyecto/.githooks/fsmonitor-datos"
if command -v node >/dev/null 2>&1; then
  node "$raiz/Claude_Proyecto/Dashboard/habitos-exportar.js" --add || true
  # Y la hora de este commit, para que cada dispositivo sepa qué versión tiene (Mi Día la enseña junto a la semana).
  node "$raiz/Claude_Proyecto/Dashboard/version-escribir.js" --add || true
  # Y las noticias de inversión de Google Noticias para Qué invertir hoy, si las que hay tienen más de una hora.
  node "$raiz/Claude_Proyecto/Dashboard/noticias-actualizar.js" --add || true
fi
exit 0
